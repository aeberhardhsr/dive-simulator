#ifndef DIVE_REFLECTION_WATER
#define DIVE_REFLECTION_WATER
#include "/DiveRendering/ReflectionWaterMask.ush"
#if !COMPUTESHADER

// All lengths below are metres except translated renderer positions and rays.
float DiveReflectionPhase(float cosine)
{
    const float g=.55;
    return (1-g*g)/(4*PI*pow(max(.001,1+g*g-2*g*cosine),1.5));
}

float DiveReflectionShadow(RaytracingAccelerationStructure SceneTLAS,float3 position,float3 toLight,float distanceCm)
{
#if DIVE_REFLECTION_PROFILE == 2
    return 1; // Diagnostic cost isolation only; never a lighting-quality mode.
#else
    // Inline opaque visibility avoids changing the payload of Lumen's minimal pass.
    RayDesc ray;
    ray.Origin=position;ray.Direction=toLight;ray.TMin=.1;ray.TMax=max(.11,distanceCm);
    RayQuery<RAY_FLAG_FORCE_OPAQUE|RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH|RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES> query;
    query.TraceRayInline(SceneTLAS,0,RAY_TRACING_MASK_SHADOW,ray);
    while(query.Proceed()) {}
    return query.CommittedStatus()==COMMITTED_NOTHING ? 1 : 0;
#endif
}

#include "/DiveRendering/ReflectionWaterShadow.ush"

float3 DiveReflectionSource(RaytracingAccelerationStructure SceneTLAS,float3 position,float3 p,float3 direction,float sigma,uint firstLight,
    int virtualShadowLight,inout float2 shadowStats)
{
    FCulledLightList lights=FCulledLightList::Create(position);
    float3 source=0;
    for(uint i=firstLight;i<lights.GetNumLights();++i)
    {
        uint valid;uint index=lights.GetLightIndex(i,valid);
        if(!valid) continue;
        uint kind;
        FDeferredLightData light=GetRayTracingDeferredLightData(index,false,kind);
        float3 toLight;float attenuation=1;float distanceCm=10000;float waterLength=0;
        if(kind==LIGHT_TYPE_DIRECTIONAL)
        {
            toLight=normalize(light.Direction);
            if(toLight.z<=0) continue;
            // Mean-plane Snell direction for the incoming beam; the wave surface
            // bounds the actual view path. Spatial caustic focusing is separate.
            float3 refracted=-refract(-toLight,float3(0,0,1),1./1.333);
            waterLength=max(0,(DiveReflectionSurface(p.xy)-p.z)/max(.1,refracted.z));
            attenuation=.98*exp(-sigma*waterLength);
            // Straight visibility ray approximation through the refracting boundary.
#if DIVE_REFLECTION_PROFILE >= 4
            float usedMap;
            attenuation*=DiveReflectionMappedShadow(SceneTLAS,position,toLight,index,virtualShadowLight,usedMap);
            shadowStats+=float2(1,usedMap);
#else
            attenuation*=DiveReflectionShadow(SceneTLAS,position,toLight,distanceCm);
#endif
            toLight=refracted;
        }
        else if(kind==LIGHT_TYPE_POINT || kind==LIGHT_TYPE_SPOT)
        {
            float3 offset=light.TranslatedWorldPosition-position;
            distanceCm=length(offset);
            if(distanceCm<.1) continue;
            attenuation=GetLocalLightAttenuation(position,light,offset,toLight);
            if(light.bInverseSquared) attenuation/=max(1.,distanceCm*distanceCm);
            if(attenuation<=0) continue;
            // Four midpoint samples clip the lamp-to-sample water segment.
            for(uint j=0;j<4;++j)
                waterLength+=DiveReflectionWet(p+toLight*(distanceCm*.01)*((j+.5)/4.))*(distanceCm*.01/4.);
            attenuation*=exp(-sigma*waterLength)*DiveReflectionShadow(SceneTLAS,position,toLight,distanceCm-.1);
        }
        else continue;
        source+=light.Color*attenuation*DiveReflectionPhase(dot(toLight,direction));
    }
    // Same authored single-scattering albedo as M_WaterVolume.
    return source*float3(.07,.24,.16)*sigma;
}

#if DIVE_REFLECTION_PROFILE == 3
struct FDiveReflectionSun
{
    float3 Direction;
    float InverseRefractedZ;
    float3 PhaseColor;
};

FDiveReflectionSun DiveCacheReflectionSun(uint index,float3 direction)
{
    FDiveReflectionSun sun=(FDiveReflectionSun)0;
    uint kind;
    FDeferredLightData light=GetRayTracingDeferredLightData(index,false,kind);
    float3 toLight=normalize(light.Direction);
    if(kind!=LIGHT_TYPE_DIRECTIONAL || toLight.z<=0) return sun;
    float3 refracted=-refract(-toLight,float3(0,0,1),1./1.333);
    sun.Direction=toLight;
    sun.InverseRefractedZ=1./max(.1,refracted.z);
    sun.PhaseColor=light.Color*(.98*DiveReflectionPhase(dot(refracted,direction)));
    return sun;
}

float3 DiveCachedSunSource(RaytracingAccelerationStructure SceneTLAS,FDiveReflectionSun sun,
    float3 position,float3 p,float sigma)
{
    if(sun.InverseRefractedZ==0) return 0;
    float waterLength=max(0,(DiveReflectionSurface(p.xy)-p.z)*sun.InverseRefractedZ);
    float attenuation=exp(-sigma*waterLength)*DiveReflectionShadow(SceneTLAS,position,sun.Direction,10000);
    return sun.PhaseColor*attenuation*float3(.07,.24,.16)*sigma;
}
#endif

float3 DiveIntegrateReflectionWater(RaytracingAccelerationStructure SceneTLAS,float3 radiance,
    float3 origin,float3 direction,float2 screenUV,float sceneDepth,float hitDistanceCm)
{
#if DIVE_REFLECTION_PROFILE == 1
    return radiance; // Diagnostic: retain raw hit routing, omit water integration.
#else
    if(!DiveIsWaterReflection(origin,screenUV,sceneDepth)) return radiance;
    float3 p=DFFastSubtractDemote(origin,PrimaryView.PreViewTranslation)*.01;
    float sigma=max(.001,Scene.DiveWater.Medium.z);
    float lengthMetres=min(max(0,hitDistanceCm*.01),min(200.,10./sigma));
    float transmittance=1;float3 scattering=0;
    float2 shadowStats=0;int virtualShadowLight=-1;
#if DIVE_REFLECTION_PROFILE >= 4
    virtualShadowLight=DiveReflectionShadowLight();
#endif
#if DIVE_REFLECTION_PROFILE == 3
    // The lake scene uses sun and moon. More infinite lights fall back to the
    // complete original list; finite lights are still culled at each sample.
    uint infiniteCount=RaytracingLightGridData.SceneInfiniteLightCount;
    bool cacheSun=infiniteCount<=2;
    FDiveReflectionSun suns[2];
    [unroll] for(uint light=0;light<2;++light)
    {
        suns[light]=(FDiveReflectionSun)0;
        if(cacheSun&&light<infiniteCount) suns[light]=DiveCacheReflectionSun(light,direction);
    }
#endif
    for(uint step=0;step<16;++step)
    {
        float a=step/16.,b=(step+1)/16.;
        float begin=lengthMetres*a*a,end=lengthMetres*b*b;
        float middle=(begin+end)*.5;
        float3 sampleP=p+direction*middle;
        float wet=DiveReflectionWet(sampleP);
        if(wet<=0) continue;
        float segment=end-begin;
        float stepT=exp(-sigma*wet*segment);
        float3 samplePosition=origin+direction*(middle*100);
#if DIVE_REFLECTION_PROFILE == 3
        float3 source=DiveReflectionSource(SceneTLAS,samplePosition,sampleP,direction,sigma,cacheSun?infiniteCount:0,virtualShadowLight,shadowStats);
        if(cacheSun)
        {
            [unroll] for(uint light=0;light<2;++light)
                source+=DiveCachedSunSource(SceneTLAS,suns[light],samplePosition,sampleP,sigma);
        }
#else
        float3 source=DiveReflectionSource(SceneTLAS,samplePosition,sampleP,direction,sigma,0,virtualShadowLight,shadowStats);
#endif
        scattering+=transmittance*source*((1-stepT)/sigma);
        transmittance*=stepT;
    }
#if DIVE_REFLECTION_PROFILE == 7
    // Diagnostic only: R = surviving radiance, G = extinction, B = upward ray.
    return float3(transmittance,1-transmittance,direction.z>0?1:0)*10000*View.PreExposure;
#elif DIVE_REFLECTION_PROFILE == 6
    // Diagnostic only: green = mapped directional shadows, red = ray fallback.
    float coverage=shadowStats.x>0 ? shadowStats.y/shadowStats.x : 0;
    // Fixed pre-exposed display signal: world-radiance scaling washed out the
    // diagnostic at the higher exposure needed to measure physical moonlight.
    return float3(1-coverage,coverage,0);
#else
    return radiance*transmittance+scattering*View.PreExposure;
#endif
#endif
}
#endif
#endif
