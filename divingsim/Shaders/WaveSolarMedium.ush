#ifndef DIVE_WAVE_SOLAR_MEDIUM
#define DIVE_WAVE_SOLAR_MEDIUM
// Prepared copy of the same analytic optics used by the visible water normals.
#include "/Engine/Private/DiveWaterOptics.ush"
#include "/DiveRendering/LakeFootprint.ush"
struct FDiveSolarSample
{
    float3 Transmission;
    float3 ToLight;
};

FDiveSolarSample DiveEvaluateWaveSolar(float3 Position,float3 ToLight,float2 FootprintX,float2 FootprintY)
{
    FDiveSolarSample result;
    result.Transmission=1;result.ToLight=ToLight;
    if(Scene.DiveWater.Enabled<.5 || ToLight.z<=0) return result;
    float3 p=DFFastSubtractDemote(Position,PrimaryView.PreViewTranslation)*.01;
    float4 waves[4]={Scene.DiveWater.Wave0,Scene.DiveWater.Wave1,Scene.DiveWater.Wave2,Scene.DiveWater.Wave3};
    float4 phases=Scene.DiveWater.Phases,medium=Scene.DiveWater.Medium;
    DiveWaterOptics optics;
    float h;float2 slope;float3 curve;
    optics.Surface(p.xy,medium.x,waves,phases,medium.y,FootprintX,FootprintY,h,slope,curve);
    float wet=smoothstep(0,.15,h-p.z);
    if(Scene.DiveWater.FootprintEnabled>.5)
    {
        FDiveLakeFootprint lake;
        wet*=lake.Wet(lake.Distance(Scene.DiveWater.Footprint,Scene.DiveWater.FootprintSampler,p.xy,Scene.DiveWater.FootprintMap));
    }
    if(wet<=0) return result;
    float3 incident=-normalize(ToLight),ray=optics.Refract(incident,float2(0,0));
    float2 uv=p.xy-ray.xy*((p.z-h)/min(-.1,ray.z));
    [unroll] for(int k=0;k<2;++k)
    {
        optics.Surface(uv,medium.x,waves,phases,medium.y,FootprintX,FootprintY,h,slope,curve);
        ray=optics.Refract(incident,slope);
        uv=p.xy-ray.xy*((p.z-h)/min(-.1,ray.z));
    }
    optics.Surface(uv,medium.x,waves,phases,medium.y,FootprintX,FootprintY,h,slope,curve);
    float3 normal=normalize(float3(-slope,1));
    float cosine=-dot(incident,normal),eta=1./1.333;
    float root=sqrt(max(.001,1-eta*eta*(1-cosine*cosine)));
    float a=eta*cosine-root;
    ray=eta*incident+a*normal;
    float path=max(0,(p.z-h)/min(-.1,ray.z));
    float normalLength=sqrt(1+dot(slope,slope));
    float3 nx=float3(-curve.x,-curve.y,0),ny=float3(-curve.y,-curve.z,0);
    nx=(nx-normal*dot(normal,nx))/normalLength;
    ny=(ny-normal*dot(normal,ny))/normalLength;
    float3 rx=a*nx+(eta-eta*eta*cosine/root)*(-dot(incident,nx))*normal;
    float3 ry=a*ny+(eta-eta*eta*cosine/root)*(-dot(incident,ny))*normal;
    float2 jx=float2(1,0)+rx.xy*path+ray.xy*((-slope.x-path*rx.z)/min(-.1,ray.z));
    float2 jy=float2(0,1)+ry.xy*path+ray.xy*((-slope.y-path*ry.z)/min(-.1,ray.z));
    float focus=clamp(1/max(.25,abs(jx.x*jy.y-jx.y*jy.x)),.25,4);
    float contrast=medium.w*exp(-path*(1./18+medium.z))*smoothstep(0,.35,path);
    float gain=lerp(1,focus,contrast);
    float3 transmission=exp(-(medium.z+float3(.12,.015,.035))*path);
    float fresnel=.02+.98*pow(1-saturate(cosine),5);
    // Bounded focusing can exceed the unfocused beam locally. It is an
    // approximation, not an energy-normalized photon or multiple-path solver.
    result.Transmission=lerp(1,(1-fresnel)*transmission*gain,wet);
    result.ToLight=normalize(lerp(ToLight,-ray,wet));
    return result;
}
#endif
