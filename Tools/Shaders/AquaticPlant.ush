// Original analytic plant surface; UV0 follows each blade/branch, UV1 contains
// blade membership and deterministic per-part variation. No world-space sliding.
float2 uv=float2(UV.x,1-UV.y);
// UV1.x distinguishes stems (0), photosynthetic branchlets (.55), blades (1).
// Fine green branchlets transmit light without inheriting broad-leaf veins.
float tissue=saturate(Detail.x);
float blade=smoothstep(.75,1,tissue),age=saturate(Detail.y);
float broad=.5+.5*sin(uv.x*14+sin(uv.y*11+age*6)*1.4)*sin(uv.y*19+age*9);
float fine=.5+.5*sin(uv.x*147+age*17)*sin(uv.y*211+age*23);
fine=lerp(.5,fine,saturate(1-max(fwidth(uv.x),fwidth(uv.y))*120));
float midWidth=max(fwidth(uv.x),.004);
float midrib=1-smoothstep(.012,.012+midWidth,abs(uv.x-.5));
float veinCoord=uv.x*8+.13*sin(uv.y*3.14159);
float veins=1-smoothstep(.025,.025+max(fwidth(veinCoord),.035),abs(frac(veinCoord)-.5));
float margin=smoothstep(.32,.5,abs(uv.x-.5));
float mottling=smoothstep(.45,.88,broad)*(.08+.2*age);
// Blender exports authored linear RGB as sRGB in FBX. Unreal's static-mesh
// color buffer retains those encoded bytes; VertexColor does not decode them.
// Decode reflectance once. Alpha remains a linear root/animation weight.
float3 encoded=saturate(C.rgb);
float3 reflectance=select(encoded>.04045,pow((encoded+.055)/1.055,2.4),encoded/12.92);
float3 color=reflectance*lerp(.85,.62,blade)*lerp(.84,1.13,broad);
color=lerp(color,color*float3(.92,.78,.57),mottling+margin*.12*blade);
color*=1+blade*(midrib*.15+veins*.055)+fine*.025;
Roughness=clamp(.58+mottling*.22+margin*.07,.54,.9);
float groove=sin(uv.x*50.2655+.13*sin(uv.y*3.14159));
float detailFade=saturate(1-max(fwidth(uv.x),fwidth(uv.y))*24);
SurfaceNormal=normalize(float3(blade*groove*.065*detailFade,blade*cos(uv.y*28+age)*.018*detailFade,1));
Transmission=color*lerp(.12,.8,tissue);
Density=lerp(.96,.58,tissue);
return color;
