diff --git a/divingsim/Source/DiveSim/Simulation/SedimentBedform.h b/divingsim/Source/DiveSim/Simulation/SedimentBedform.h
new file mode 100644
index 0000000..cc90245
--- /dev/null
+++ b/divingsim/Source/DiveSim/Simulation/SedimentBedform.h
@@ -0,0 +1,25 @@
+#pragma once
+#include "BedDistribution.h"
+
+namespace Dive
+{
+// Authored sub-metre relief on the measured metre grid, not survey data or
+// a sediment-transport simulation. World coordinates make streaming repeatable.
+struct SedimentBedform
+{
+    static constexpr double Maximum=45; // centimetres, before habitat masks
+    static double Height(double xMetres,double yMetres,double depthMetres)
+    {
+        using B=BedDistribution;
+        if(!std::isfinite(xMetres)||!std::isfinite(yMetres)||!std::isfinite(depthMetres)||
+           std::abs(xMetres)>1.e7||std::abs(yMetres)>1.e7) return 0;
+        const double warp=(B::Noise(xMetres/17,yMetres/17)-.5)*5;
+        const double along=xMetres*.62+yMetres*.7846+warp;
+        const double across=-xMetres*.7846+yMetres*.62;
+        const double ridge=B::Smooth(.28,.78,B::Noise(along/3.8,across/8.5));
+        const double envelope=.45+.55*B::Noise(xMetres/21+13,yMetres/21-7);
+        const double fineSediment=.35+.65*(1-B::Gravel(xMetres,yMetres,depthMetres));
+        return Maximum*ridge*envelope*fineSediment;
+    }
+};
+}
