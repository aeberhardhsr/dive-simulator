diff --git a/Tests/SedimentBedformTests.cpp b/Tests/SedimentBedformTests.cpp
new file mode 100644
index 0000000..5596824
--- /dev/null
+++ b/Tests/SedimentBedformTests.cpp
@@ -0,0 +1,31 @@
+#include "../divingsim/Source/DiveSim/Simulation/SedimentBedform.h"
+#include <iostream>
+#include <limits>
+
+int main()
+{
+    using S=Dive::SedimentBedform;
+    int failures=0;double lowest=100,highest=0,maxStep=0;
+    auto check=[&](bool value,const char* why){if(!value){++failures;std::cerr<<why<<'\n';}};
+    for(double origin:{-17000.,0.,5300.}) for(int y=-64;y<=64;++y) for(int x=-64;x<=64;++x)
+    {
+        const double px=origin+x,py=origin*.37+y;
+        const double h=S::Height(px,py,8);
+        check(std::isfinite(h)&&h>=0&&h<=S::Maximum,"Bedform exceeds bounded relief");
+        lowest=std::min(lowest,h);highest=std::max(highest,h);
+        maxStep=std::max(maxStep,std::abs(h-S::Height(px+1,py,8)));
+        maxStep=std::max(maxStep,std::abs(h-S::Height(px,py+1,8)));
+        check(h==S::Height(px,py,8),"World-space reconstruction changed");
+    }
+    check(highest-lowest>20,"Relief lacks spatial variation");
+    check(maxStep<45,"Metre-grid relief produced a vertical step");
+    for(double boundary:{-192.,-96.,0.,96.,192.}) for(double along:{-31.7,0.,27.4})
+    {
+        check(std::abs(S::Height(boundary-1.e-7,along,8)-S::Height(boundary+1.e-7,along,8))<1.e-4,"Streaming X seam");
+        check(std::abs(S::Height(along,boundary-1.e-7,8)-S::Height(along,boundary+1.e-7,8))<1.e-4,"Streaming Y seam");
+    }
+    check(S::Height(std::numeric_limits<double>::infinity(),0,8)==0,"Invalid coordinates accepted");
+    check(S::Height(0,0,std::numeric_limits<double>::quiet_NaN())==0,"Invalid depth accepted");
+    std::cout<<"Sediment bedforms: "<<failures<<" failures; range="<<lowest<<".."<<highest<<"cm max metre step="<<maxStep<<"cm\n";
+    return failures?1:0;
+}
