diff --git a/Tools/TestWaterScatteringBalance.ps1 b/Tools/TestWaterScatteringBalance.ps1
new file mode 100644
--- /dev/null
+++ b/Tools/TestWaterScatteringBalance.ps1
@@ -0,0 +1,42 @@
+param([switch]$Preview)
+$ErrorActionPreference='Stop'
+$repo=Split-Path $PSScriptRoot -Parent
+if(Get-Process | Where-Object {$_.ProcessName -like 'UnrealEditor*' -or $_.ProcessName -like 'divingsim*'}) {throw 'An Unreal/game process is already running.'}
+$runtime=Join-Path $repo 'Builds/EditorSandbox/divingsim'
+$root=Join-Path $repo ('artifacts/water-scattering-balance-'+(Get-Date -Format 'yyyyMMdd-HHmmss'))
+New-Item -ItemType Directory -Force $root | Out-Null
+$files=@(Get-ChildItem (Join-Path $repo 'divingsim/Source/DiveSim') -File -Recurse)
+$files+=Get-ChildItem (Join-Path $repo 'divingsim/Content/Diving/Materials') -Filter '*.uasset'
+foreach($f in @('Tools/SmokeTest.ps1','Tools/TestWaterScatteringBalance.ps1','Tools/build_water_volume_content.py','divingsim/Config/DefaultEngine.ini')) {$files+=Get-Item (Join-Path $repo $f)}
+$files+=Get-Item (Join-Path $runtime 'Binaries/Win64/UnrealEditor-DiveSim.dll')
+$inputs=@($files | Sort-Object FullName -Unique | ForEach-Object {
+    @{file=$_.FullName.Substring($repo.Length+1).Replace('\','/');sha256=(Get-FileHash -LiteralPath $_.FullName).Hash.ToLowerInvariant()}
+})
+@{preview=[bool]$Preview;source_head=(& git -C $repo rev-parse HEAD);files=$inputs} | ConvertTo-Json -Depth 6 | Set-Content (Join-Path $root 'Host.json') -Encoding utf8
+$cases=@(@{name='bed';hour=12},@{name='sun';hour=12;sun=$true},@{name='morning';hour=7.5})
+if(-not $Preview) {$cases+=@(@{name='clear';hour=12;visibility=40},@{name='turbid';hour=12;visibility=3},@{name='surface';hour=12;surface=$true},@{name='night-off';hour=1.5;torch=$true;off=$true},@{name='night-on';hour=1.5;torch=$true},@{name='fallback';hour=12;fallback=$true})}
+$completed=@()
+foreach($case in $cases) { foreach($study in @($false,$true)) {
+    $name=$case.name+$(if($study){'-study'}else{'-baseline'})
+    $folder=Join-Path $root $name;New-Item -ItemType Directory -Force $folder | Out-Null
+    $opts=@{EditorSandbox=$true;Scenario='rocks';Entry=0;Hour=$case.hour;Date='2026-06-21';MaxFPS=30;WaterPreview=$true;WaterScatterStudy=$study;RuntimeLog=(Join-Path $folder 'Runtime.log')}
+    if($case.visibility) {$opts.Visibility=$case.visibility}
+    if($case.torch) {$opts.Scenario='torch';$opts.LampOff=[bool]$case.off}
+    elseif($case.surface) {$opts.WaterView=$true;$opts.WaterStart=1;$opts.WaterEnd=1}
+    else {$opts.HabitatView=$true;if($case.sun){$opts.HabitatSunView=$true}else{$opts.HabitatLowView=$true}}
+    if($case.fallback) {$opts.DisableVolumetrics=$true}
+    $started=[DateTime]::UtcNow
+    & (Join-Path $PSScriptRoot 'SmokeTest.ps1') @opts *> (Join-Path $folder 'Summary.log')
+    $log=Get-Content $opts.RuntimeLog -Raw
+    if($log -match 'DIVE_\w*FAIL|Failed to compile Material|Default Material will be used|Fatal error:') {throw "Rendering failed: $name"}
+    if($log -notmatch ('DIVE_WATER_SCATTER study='+[int]$study)) {throw "Missing study marker: $name"}
+    $images=@(Get-ChildItem (Join-Path $runtime 'Saved/Screenshots') -Filter '*.png' -File | Where-Object {$_.LastWriteTimeUtc -ge $started})
+    $expected=if($case.torch){2}else{3}
+    if($images.Count -ne $expected) {throw "Missing captures $name : $($images.Count)/$expected"}
+    $images | Copy-Item -Destination $folder
+    $completed+=@{name=$name;study=$study;options=$opts;status='PASS';images=@($images.Name)}
+    $completed | ConvertTo-Json -Depth 5 | Set-Content (Join-Path $root 'Cases.json') -Encoding utf8
+    Write-Output "PASS $name"
+} }
+foreach($input in $inputs) {if((Get-FileHash -LiteralPath (Join-Path $repo $input.file)).Hash.ToLowerInvariant() -ne $input.sha256) {throw "Input changed during tests: $($input.file)"}}
+Write-Output "WATER_SCATTERING_BALANCE=$root"
