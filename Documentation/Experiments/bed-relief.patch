+    float ReliefDepth(Texture2D sand,Texture2D gravel,SamplerState sharedSampler,
+        float2 p,float2 dx,float2 dy,float gravelWeight)
+    {
+        float sh=Texture2DSampleGrad(sand,sharedSampler,p/250,dx/250,dy/250).r;
+        float gh=Texture2DSampleGrad(gravel,sharedSampler,p/290,dx/290,dy/290).r;
