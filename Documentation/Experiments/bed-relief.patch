+    float3 Relief(Texture2D sand,Texture2D gravel,SamplerState sharedSampler,
+        float3 p,float3 n,float3 camera,float gravelWeight,float strength)
+    {
+        float3 v=normalize(camera-p);
+        float facing=dot(v,n);
+        float fade=strength*(1-smoothstep(800,1600,distance(camera,p)))
+            *smoothstep(.76,.92,n.z)*smoothstep(.08,.25,facing)*(1-smoothstep(-20,0,p.z));
+        // Derivatives must be evaluated outside the divergent march. Explicit
+        // gradients preserve mip selection and avoid grazing-angle shimmer.
+        float2 dx=ddx(p.xy),dy=ddy(p.xy);
+        [branch] if(fade<.001) return p;
+        float3 ray=-v/max(facing,.08);
+        int steps=(int)lerp(28,12,saturate(facing));
+        float stepDepth=6.0/steps;
+        float depth=0,previousDepth=0,previousError=0;
+        float error=-ReliefDepth(sand,gravel,sharedSampler,p.xy,dx,dy,gravelWeight);
+        [loop] for(int i=0;i<28;++i)
+        {
+            if(i>=steps||error>=0) break;
+            previousDepth=depth;previousError=error;depth+=stepDepth;
+            error=depth-ReliefDepth(sand,gravel,sharedSampler,(p+ray*depth*fade).xy,dx,dy,gravelWeight);
+        }
+        float fraction=saturate(-previousError/max(error-previousError,.0001));
+        return p+ray*lerp(previousDepth,depth,fraction)*fade;
+    }
