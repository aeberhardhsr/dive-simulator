diff --git a/Tools/ReportBedRelief.py b/Tools/ReportBedRelief.py
new file mode 100644
index 0000000..9724ab0
--- /dev/null
+++ b/Tools/ReportBedRelief.py
@@ -0,0 +1,98 @@
+"""Bind height-based bed comparisons to exact runtime, assets and captures."""
+import argparse
+import json
+import re
+from pathlib import Path
+
+import numpy as np
+from ReportNativeWaterLighting import ROOT, pixels, record, sha
+from ReportRocks import package_check
+from analyze_performance import analyze
+
+
+def read(path):
+    return json.loads(path.read_text(encoding='utf-8-sig'))
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('run',type=Path)
+    parser.add_argument('--output',type=Path,required=True)
+    parser.add_argument('--benchmark',type=Path,action='append',default=[])
+    args=parser.parse_args()
+    run=args.run.resolve()
+    host=read(run/'Host.json')
+    for item in host['files']:
+        assert sha(ROOT/item['file'])==item['sha256'],item['file']
+    if host['packaged']:
+        package_check(host)
+    names={'weesen-before':3,'weesen-after':3}
+    if not host['preview']:
+        names.update({'ledi-before':3,'ledi-after':3,'murg-before':3,'murg-after':3,'raster':3,'stream':2,'shore':9,'sediment':7})
+    cases=read(run/'Cases.json')
+    assert len(cases)==len(names) and {c['name'] for c in cases}==set(names)
+    evidence=[];logs={}
+    for case in cases:
+        name=case['name'];folder=run/name
+        log=(folder/'Runtime.log').read_text(encoding='utf-8-sig');logs[name]=log
+        assert case['status']=='PASS' and 'DIVE_SMOKE_PASS' in log
+        assert not re.search(r'DIVE_\w*FAIL|Failed to compile Material|Default Material will be used|Fatal error:',log)
+        assert 'DIVE_WATER_PREVIEW_READY smoke=1 hardware=1 bounded=1 interface=1 lighting_mode=2' in log
+        disabled=name.endswith('-before')
+        assert ('-DiveBedReliefOff' in log)==disabled
+        strengths=re.findall(r'DIVE_BED_RELIEF_PASS strength=([\d.]+)',log)
+        assert strengths and all(float(v)==(0 if disabled else 1) for v in strengths)
+        if name not in {'shore','sediment'}:
+            for marker in ['DIVE_GRAVEL_PASS','DIVE_POPULATION_PASS','DIVE_POPULATION_RETIREMENT_PASS','DIVE_POPULATION_NEAR_TELEPORT_PASS']:
+                assert marker in log,marker
+        if name=='raster': assert 'r.Nanite = "0"' in log
+        images=sorted(folder.glob('*.png'))
+        assert len(images)==names[name]==case['screenshots']
+        for path in images: pixels(path)
+        evidence.append(dict(**case,runtime=record(folder/'Runtime.log'),images=[record(p) for p in images],
+                             engine_errors=[s for s in log.splitlines() if ': Error:' in s]))
+    pairs=[]
+    for site in ['weesen'] if host['preview'] else ['weesen','ledi','murg']:
+        before,after=site+'-before',site+'-after'
+        poses=[re.findall(r'DIVE_HABITAT_VIEW ([^\r\n]+)',logs[n]) for n in [before,after]]
+        assert len(poses[0])==3 and poses[0]==poses[1]
+        for i in range(3):
+            paths=[run/n/f'Habitat_0_{i}.png' for n in [before,after]]
+            delta=np.abs(pixels(paths[0])-pixels(paths[1]))
+            pairs.append(dict(site=site,pose=poses[0][i],before=record(paths[0]),after=record(paths[1]),
+                              mean_absolute_rgb_difference=float(delta.mean()),
+                              bed_lower_half_difference=float(delta[450:].mean())))
+    sources=read(ROOT/'Documentation/BED_RELIEF_SOURCES.json')
+    assert {a['id'] for a in sources['assets']}=={'gravelly_sand','river_small_rocks'}
+    for source in sources['assets']: assert sha(ROOT/source['file'])==source['sha256']
+    benchmarks=[]
+    for folder in args.benchmark:
+        folder=folder.resolve();result=analyze(folder)
+        h,m=result['host'],result['metadata']
+        assert not h['background_processes'] and h['water_preview']
+        assert m['bed_relief']==h['bed_relief']
+        if host['packaged']:
+            assert not h['editor'] and h['executable_sha256']==host['sha256'].lower()
+            assert h['package_containers']==host['package_containers']
+        for key,value in {'width':1920,'height':1080,'quality':2,'r.ScreenPercentage':100,'r.VSync':0,'t.MaxFPS':0}.items():
+            assert m[key]==value,(key,m[key])
+        benchmarks.append(dict(result=result,files=[record(folder/n) for n in ['Capture.csv','Metadata.json','Host.json','Frame.png','Runtime.log']]))
+    launcher=None
+    if host['packaged']:
+        launcher=read(run/'launcher/Launcher.json')
+        assert launcher['status']=='PASS' and launcher['exit_code']==0
+        assert launcher['executable_sha256'].lower()==host['sha256'].lower()
+        assert launcher['log_sha256'].lower()==sha(run/'launcher/Launcher.log')
+        assert len(benchmarks)>=2
+    result=dict(status='PASS',scope='Bound runtime and visual comparisons, not full reference-quality acceptance',
+                host=host,cases=evidence,comparisons=pairs,sources=sources,benchmarks=benchmarks,launcher=launcher,
+                limitations=['Parallax changes shading coordinates, not collision, silhouettes or real geometry',
+                             'No self-shadow tracing or pixel-depth offset',
+                             'Short captures do not establish temporal stability or sustained performance',
+                             'Image differences alone do not prove an improvement'])
+    args.output.write_text(json.dumps(result,indent=2,ensure_ascii=False)+'\n',encoding='utf-8')
+    print(f'BED_RELIEF_PASS cases={len(cases)} captures={sum(names.values())}')
+
+
+if __name__=='__main__':
+    main()
